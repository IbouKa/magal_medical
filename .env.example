# Copier ce fichier en .env pour le développement local
# -------------------------------------------------------
# DÉVELOPPEMENT LOCAL
# -------------------------------------------------------
SECRET_KEY=votre-cle-secrete-tres-longue-ici
DATABASE_URL=sqlite:///instance/magal_medical.db
FLASK_DEBUG=True

# -------------------------------------------------------
# PRODUCTION RAILWAY
# -------------------------------------------------------
# Dans Railway Dashboard → votre service app → Variables :
#
# 1. Ajouter une référence de variable vers le service Postgres :
#    Nom    : DATABASE_URL
#    Valeur : ${{Postgres.DATABASE_URL}}
#
# 2. Ajouter une clé secrète forte :
#    Nom    : SECRET_KEY
#    Valeur : (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
#
# 3. Optionnel - désactiver le debug en prod :
#    Nom    : FLASK_DEBUG
#    Valeur : False
#
# Note : DATABASE_URL est automatiquement fourni par le service Postgres Railway.
#        La variable ${{Postgres.DATABASE_URL}} est la syntaxe de référence Railway
#        qui injecte la valeur interne (réseau privé, sans frais de transfert).